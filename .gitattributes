# Normalise to LF in the repository; Git checks out the platform default.
* text=auto

*.go     text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.html   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1    text eol=crlf

*.jar    binary
*.exe    binary
*.ico    binary
*.png    binary
